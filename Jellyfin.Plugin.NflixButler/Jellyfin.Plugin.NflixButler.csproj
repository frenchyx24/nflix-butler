<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Jellyfin.Plugin.NflixButler</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.NflixButler</RootNamespace>
    <Version>0.4.1.4</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/config.html" />
    <EmbeddedResource Include="Web/dashboard.html" />
    <EmbeddedResource Include="Web/page.html" />
  </ItemGroup>

</Project>
